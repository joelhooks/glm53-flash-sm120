+# [0, 288) prefix of the NVFP4 record above -- 256B packed E2M1 latent + 32B
+# E4M3 group-16 scales -- optionally followed by the fp32 per-token latent
+# scale at [288, 292) and 12B of 16B-alignment pad (304B stride):
+#
+#     [  0, 256)  packed E2M1 latent (512 x 4-bit, 32 group-16 blocks)
+#     [256, 288)  32 x E4M3 group scale bytes
+#     [288, 292)  fp32 per-token latent scale   } latent_scale_per_token
+#     [292, 304)  zero pad (16B align)          } only
+#
+# There is NO RoPE sub-record, so (a) the per-token record stride is 288/304 --
+# NOT the 432 of the rope-bearing NVFP4 record -- and (b) the generic NVFP4
+# arm's SECOND cp.async.bulk (the rope tail) must not be issued at all.
+_NVFP4_NO_ROPE_GMEM_STRIDE = 288
+_NVFP4_NO_ROPE_PTS_GMEM_STRIDE = 304
+# 8B-aligned source of the fp32 per-token latent scale word pair. Both NVFP4
+# two-level records put it at +288: the 368B fp8-rope record keeps the SECOND
+# word ([292,296); [288,292) is its rope scale), the 304B NoPE record keeps the
+# FIRST word ([288,292); [292,296) is pad).
+_NVFP4_LATENT_SCALE_SRC = 288
 
 # IO warp width (one warp = 32 threads; FlashInfer DSV4_IO_THREADS).
