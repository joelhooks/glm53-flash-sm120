+def _nvfp4_no_rope_gmem_stride(
+    kv_gmem_stride: int, per_token_latent_scale: bool
+) -> int:
+    """Resolve the GLM_NOPE per-token record stride at TRACE time (pure Python).
+
+    ``kv_gmem_stride`` (0 == unspecified) lets a caller thread
+    ``traits.kv_gmem_stride`` straight through and is then AUTHORITATIVE. When
+    it is omitted the stride follows ``latent_scale_per_token`` exactly the way
+    ``make_unified_traits`` derives it (288 without the per-token fp32 latent
+    scale, 304 with it), so the device geometry can never drift from the trait
+    that sized the cache.
+    """
+    if kv_gmem_stride:
+        if int(kv_gmem_stride) not in (
+            _NVFP4_NO_ROPE_GMEM_STRIDE,
+            _NVFP4_NO_ROPE_PTS_GMEM_STRIDE,
+        ):
+            raise ValueError(
+                "GLM_NOPE kv_gmem_stride must be 288 or 304 (the rope-less "
+                f"NVFP4 record); got {int(kv_gmem_stride)}"
+            )
+        return int(kv_gmem_stride)
+    return (
+        _NVFP4_NO_ROPE_PTS_GMEM_STRIDE
+        if per_token_latent_scale
+        else _NVFP4_NO_ROPE_GMEM_STRIDE
+    )
+
