+            bulk_tx_bytes=64 * 288,
+            v_has_rope=False,
+            has_extra_cache=False,
+            fp8_rope=False,
+            rope_gmem_offset=-1,
+            rope_payload_bytes=0,
+            rope_scale_offset=-1,
