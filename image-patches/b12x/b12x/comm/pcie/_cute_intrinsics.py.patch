+                Uint32(left).ir_value(loc=loc, ip=ip),
+                Uint32(right).ir_value(loc=loc, ip=ip),
+            ],
+            "add.rn.f16x2 $0, $1, $2;",
+            "=r,r,r",
+            has_side_effects=False,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+    )
+
