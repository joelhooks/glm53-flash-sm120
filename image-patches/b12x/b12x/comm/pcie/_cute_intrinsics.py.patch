+@dsl_user_op
+def clear_pos_zero_u16x2(value: Uint32, *, loc=None, ip=None) -> Uint32:
+    """Reserve positive zero in each 16-bit lane as an unpublished marker."""
+
+    return Uint32(
+        llvm.inline_asm(
+            T.i32(),
+            [Uint32(value).ir_value(loc=loc, ip=ip)],
+            """
+            {
+                .reg .pred lo_set, hi_set;
+                .reg .b32 lo, hi;
+                and.b32 lo, $1, 0x0000ffff;
+                and.b32 hi, $1, 0xffff0000;
+                setp.ne.u32 lo_set, lo, 0;
+                setp.ne.u32 hi_set, hi, 0;
+                selp.u32 lo, lo, 0x00008000, lo_set;
+                selp.u32 hi, hi, 0x80000000, hi_set;
+                or.b32 $0, lo, hi;
+            }
+            """,
+            "=r,r",
+            has_side_effects=False,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+    )
+
+
+@dsl_user_op
+def has_pos_zero_u16x2(value: Uint32, *, loc=None, ip=None) -> Uint32:
+    """Return one while either 16-bit lane is still unpublished."""
+
+    return Uint32(
+        llvm.inline_asm(
+            T.i32(),
+            [Uint32(value).ir_value(loc=loc, ip=ip)],
+            """
+            {
+                .reg .pred lo_zero, hi_zero, waiting;
+                .reg .b32 lo, hi;
+                and.b32 lo, $1, 0x0000ffff;
+                and.b32 hi, $1, 0xffff0000;
+                setp.eq.u32 lo_zero, lo, 0;
+                setp.eq.u32 hi_zero, hi, 0;
+                or.pred waiting, lo_zero, hi_zero;
+                selp.u32 $0, 1, 0, waiting;
+            }
+            """,
+            "=r,r",
+            has_side_effects=False,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+    )
+
