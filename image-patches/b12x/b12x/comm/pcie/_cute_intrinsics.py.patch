+@dsl_user_op
+def add_f16x2(left: Uint32, right: Uint32, *, loc=None, ip=None) -> Uint32:
+    """Add two packed FP16 lanes with round-to-nearest semantics."""
+
+    return Uint32(
+        llvm.inline_asm(
+            T.i32(),
