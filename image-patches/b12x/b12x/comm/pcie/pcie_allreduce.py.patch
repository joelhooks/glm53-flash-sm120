@@ -34,7 +34,10 @@ from .pcie_oneshot import (
     DEFAULT_MAX_SIZE,
     DEFAULT_RANK_DATA_BYTES,
     SUPPORTED_WORLD_SIZES as ONESHOT_WORLD_SIZES,
+    TP2_PLAIN_REMOTE_PUSH_MAX_BYTES,
