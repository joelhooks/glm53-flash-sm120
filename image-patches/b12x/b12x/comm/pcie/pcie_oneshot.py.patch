+    def should_route_plain_allreduce(
+        self,
+        inp: torch.Tensor,
+        *,
+        generic_max_bytes: int,
+    ) -> bool:
+        """Return whether plain all-reduce should use B12X instead of NCCL.
+
+        ``should_allreduce`` defines functional support. This method adds the
+        qualified latency policy used by callers with an NCCL fallback. TP2
+        uses peer-push only for its 4096-wide FP16/BF16 contract; other TP2
+        shapes retain the caller's generic small-message band. A measured TP4
+        policy may extend that generic band for exact scheduler row counts,
+        while unmeasured TP4 tensors retain the generic route. Other world
+        sizes preserve the caller-supplied size policy.
+        """
+
+        if not self.should_allreduce(inp):
+            return False
+        generic_max_bytes = int(generic_max_bytes)
+        if generic_max_bytes < 0:
+            raise ValueError("generic_max_bytes must be non-negative")
+        if self._plain_route_policy is not None:
+            calibrated = self._plain_route_policy.decision(inp)
+            if calibrated is not None:
+                return calibrated
+        inp_bytes = inp.numel() * inp.element_size()
+        if self.world_size == 2:
+            remote_push = (
+                self._eager_ptrs is not None
+                and self._transport_policy[2]
+                and _tp2_plain_remote_push_rows(inp) is not None
+            )
+            return remote_push or inp_bytes <= generic_max_bytes
+        if self.world_size == 4:
+            return inp_bytes <= generic_max_bytes
+        return True
