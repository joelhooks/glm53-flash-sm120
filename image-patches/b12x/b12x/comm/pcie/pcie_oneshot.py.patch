+@dataclass(frozen=True)
+class PlainAllReduceRoutePolicy:
+    """Shape-specific B12X/NCCL decisions produced by the startup probe.
+
+    A policy is valid only for one tensor-parallel world, hidden size, and
+    dtype. Rows listed in ``measured_rows`` have an explicit decision; other
+    tensors continue through the static compatibility policy. This preserves
+    operator overrides and avoids extrapolating a benchmark beyond its input
+    contract.
+    """
+
+    world_size: int
+    hidden_size: int
+    dtype: torch.dtype
+    measured_rows: frozenset[int]
+    custom_rows: frozenset[int]
+
+    def __post_init__(self) -> None:
+        if self.world_size < 2:
+            raise ValueError("plain all-reduce policy world_size must be at least 2")
+        if self.hidden_size <= 0:
+            raise ValueError("plain all-reduce policy hidden_size must be positive")
+        if self.dtype not in SUPPORTED_DTYPES:
+            raise ValueError(f"unsupported plain all-reduce policy dtype {self.dtype}")
+        if not self.measured_rows:
+            raise ValueError("plain all-reduce policy measured_rows must not be empty")
+        if any(row <= 0 for row in self.measured_rows):
+            raise ValueError("plain all-reduce policy rows must be positive")
+        if not self.custom_rows.issubset(self.measured_rows):
+            raise ValueError(
+                "plain all-reduce policy custom_rows must be a subset of measured_rows"
+            )
+
+    def decision(self, inp: torch.Tensor) -> Optional[bool]:
+        """Return the measured route, or ``None`` outside the policy domain."""
+
+        if (
+            inp.dtype != self.dtype
+            or inp.ndim == 0
+            or int(inp.shape[-1]) != self.hidden_size
+            or inp.numel() % self.hidden_size != 0
+        ):
+            return None
+        rows = inp.numel() // self.hidden_size
+        if rows not in self.measured_rows:
+            return None
+        return rows in self.custom_rows
+
+    def contract(self) -> tuple[object, ...]:
+        """Return a rank-comparable representation of the routing contract."""
+
+        return (
+            PLAIN_ALLREDUCE_POLICY_VERSION,
+            self.world_size,
+            self.hidden_size,
+            str(self.dtype).removeprefix("torch."),
+            tuple(sorted(self.measured_rows)),
+            tuple(sorted(self.custom_rows)),
+        )
+
+    def to_json(self) -> str:
+        """Serialize the policy for ``B12X_PCIE_PLAIN_ALLREDUCE_POLICY``."""
+
+        return json.dumps(
+            {
+                "version": PLAIN_ALLREDUCE_POLICY_VERSION,
+                "world_size": self.world_size,
+                "hidden_size": self.hidden_size,
+                "dtype": str(self.dtype).removeprefix("torch."),
+                "measured_rows": sorted(self.measured_rows),
+                "custom_rows": sorted(self.custom_rows),
+            },
+            separators=(",", ":"),
+            sort_keys=True,
+        )
+
+
+def parse_plain_allreduce_route_policy(
+    value: Optional[str],
+    *,
+    world_size: int,
+) -> Optional[PlainAllReduceRoutePolicy]:
+    """Parse a startup-probe policy and validate its complete input domain."""
+
+    if value is None or not value.strip():
+        return None
+    try:
+        payload = json.loads(value)
+    except json.JSONDecodeError as exc:
+        raise ValueError("plain all-reduce policy must be valid JSON") from exc
+    if not isinstance(payload, dict):
+        raise ValueError("plain all-reduce policy must be a JSON object")
+    required = {
+        "version",
+        "world_size",
+        "hidden_size",
+        "dtype",
+        "measured_rows",
+        "custom_rows",
+    }
+    if set(payload) != required:
+        missing = sorted(required - set(payload))
+        unknown = sorted(set(payload) - required)
+        raise ValueError(
+            "plain all-reduce policy fields differ from the versioned schema; "
+            f"missing={missing}, unknown={unknown}"
+        )
+    if payload["version"] != PLAIN_ALLREDUCE_POLICY_VERSION:
+        raise ValueError(
+            f"unsupported plain all-reduce policy version {payload['version']!r}"
+        )
+    policy_world_size = int(payload["world_size"])
+    if policy_world_size != int(world_size):
+        raise ValueError(
+            "plain all-reduce policy world_size does not match the runtime: "
+            f"policy={policy_world_size}, runtime={world_size}"
+        )
+    dtype_names = {
+        "float16": torch.float16,
+        "bfloat16": torch.bfloat16,
+        "float32": torch.float32,
+    }
+    dtype_name = str(payload["dtype"])
+    if dtype_name not in dtype_names:
+        raise ValueError(f"unsupported plain all-reduce policy dtype {dtype_name!r}")
+    try:
+        measured_rows = frozenset(int(row) for row in payload["measured_rows"])
+        custom_rows = frozenset(int(row) for row in payload["custom_rows"])
+    except (TypeError, ValueError) as exc:
+        raise ValueError("plain all-reduce policy rows must be integer lists") from exc
+    return PlainAllReduceRoutePolicy(
+        world_size=policy_world_size,
+        hidden_size=int(payload["hidden_size"]),
+        dtype=dtype_names[dtype_name],
+        measured_rows=measured_rows,
+        custom_rows=custom_rows,
+    )
+
+
