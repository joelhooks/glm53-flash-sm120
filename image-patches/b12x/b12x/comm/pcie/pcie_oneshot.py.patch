+    def _tp2_plain_remote_push_geometry(
+        state: _CuTeOneshotState,
+        inp: torch.Tensor,
+    ) -> Optional[tuple[int, int, bool]]:
+        """Return the qualified TP2 peer-push geometry for a plain all-reduce.
+
+        The protocol is restricted to staged 4096-wide FP16/BF16 rows. Its
+        upper bound leaves large messages to the caller's collective selector,
+        where NCCL or a bulk B12X transport has lower latency.
+        """
+
+        if (
+            state.eager_tables is None
+            or state.world_size != 2
+            or not state.transport_policy[2]
+        ):
+            return None
+        rows = _tp2_plain_remote_push_rows(inp)
+        if rows is None:
+            return None
+        if rows == 1:
+            return 64, 128, False
+        if rows == 2:
+            return 128, 64, True
+        if rows <= 4:
+            return 256, 64, True
+        if rows <= 6:
+            return 64, 16, False
+        if rows <= 8:
+            return 256, 32, False
+        if rows <= 14:
+            return 64, 16, False
+        if rows <= 16:
+            return 64, 64, True
+        if rows <= 22:
+            return 128, 16, False
+        if rows <= 24:
+            return 128, 32, True
+        return 128, 16, False
