+    device_major: int | None = None,
+) -> tuple[int, int, int, int]:
+    """Select a qualified full-rotation W4A16 weight/kernel tile.
+
+    Keep one established N=256 storage layout. The exact GLM-5.3 route-128
+    SMEM/register launch specialization is selected independently from this
+    prepared-weight ABI.
+    """
+
+    hidden_size = int(hidden_size)
+    intermediate_size = int(intermediate_size)
+    if hidden_size % 128 or intermediate_size % 128:
+        raise ValueError(
+            "full-rotation W4A16 requires hidden and intermediate dimensions "
+            "divisible by 128"
+        )
+    if device_major is None:
+        resolved_device = torch.device("cuda" if device is None else device)
+        if resolved_device.type != "cuda":
+            raise ValueError("full-rotation W4A16 tile selection requires CUDA")
+        device_major = int(torch.cuda.get_device_capability(resolved_device)[0])
+
+    if hidden_size % 256 == 0 and intermediate_size % 256 == 0:
+        return (64, 256, 64, 256)
+    return (64, 128, 64, 128)
+
