+def test_plain_allreduce_route_uses_calibrated_decisions(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    policy = PlainAllReduceRoutePolicy(
+        world_size=4,
+        hidden_size=4096,
+        dtype=torch.bfloat16,
+        measured_rows=frozenset((1, 8, 16, 24, 32)),
+        custom_rows=frozenset((1, 8, 24)),
+    )
+    monkeypatch.setenv("B12X_PCIE_PLAIN_ALLREDUCE_POLICY", policy.to_json())
+    runtime = _make_runtime(world_size=4, eager=True)
+
+    assert runtime.should_route_plain_allreduce(
+        torch.empty((8, 4096), dtype=torch.bfloat16),
+        generic_max_bytes=84 * 1024,
+    )
+    assert not runtime.should_route_plain_allreduce(
+        torch.empty((16, 4096), dtype=torch.bfloat16),
+        generic_max_bytes=84 * 1024,
+    )
+    # A measured decision can extend beyond the generic 84 KiB route.
+    assert runtime.should_route_plain_allreduce(
+        torch.empty((24, 4096), dtype=torch.bfloat16),
+        generic_max_bytes=84 * 1024,
+    )
+    assert not runtime.should_route_plain_allreduce(
+        torch.empty((32, 4096), dtype=torch.bfloat16),
+        generic_max_bytes=84 * 1024,
+    )
+    # Unmeasured shapes retain the static compatibility route.
+    assert runtime.should_route_plain_allreduce(
+        torch.empty((4, 4096), dtype=torch.bfloat16),
+        generic_max_bytes=84 * 1024,
+    )
