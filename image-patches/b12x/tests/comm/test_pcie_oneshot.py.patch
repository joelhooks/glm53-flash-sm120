+def test_plain_allreduce_route_policy_round_trip_and_domain() -> None:
+    policy = PlainAllReduceRoutePolicy(
+        world_size=4,
+        hidden_size=4096,
+        dtype=torch.bfloat16,
+        measured_rows=frozenset((1, 8, 16, 32)),
+        custom_rows=frozenset((1, 8)),
+    )
+
+    parsed = parse_plain_allreduce_route_policy(policy.to_json(), world_size=4)
+
+    assert parsed == policy
+    assert parsed is not None
+    assert parsed.decision(torch.empty((1, 4096), dtype=torch.bfloat16)) is True
+    assert parsed.decision(torch.empty((16, 4096), dtype=torch.bfloat16)) is False
+    assert parsed.decision(torch.empty((4, 4096), dtype=torch.bfloat16)) is None
+    assert parsed.decision(torch.empty((1, 6144), dtype=torch.bfloat16)) is None
+    assert parsed.decision(torch.empty((1, 4096), dtype=torch.float16)) is None
+
+
+@pytest.mark.parametrize(
+    ("payload", "message"),
+    (
+        ('{"version":2}', "fields differ"),
+        (
+            '{"custom_rows":[1],"dtype":"bfloat16","hidden_size":4096,'
+            '"measured_rows":[1],"version":1,"world_size":2}',
+            "does not match",
+        ),
+        (
+            '{"custom_rows":[2],"dtype":"bfloat16","hidden_size":4096,'
+            '"measured_rows":[1],"version":1,"world_size":4}',
+            "must be a subset",
+        ),
+    ),
+)
+def test_plain_allreduce_route_policy_rejects_invalid_contract(
+    payload: str,
+    message: str,
+) -> None:
+    with pytest.raises(ValueError, match=message):
+        parse_plain_allreduce_route_policy(payload, world_size=4)
+
