+    def get_top_k_tokens(
+        self,
+        lm_head: VocabParallelEmbedding,
+        hidden_states: torch.Tensor,
+        k: int,
+        embedding_bias: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Compute a global vocab-parallel top-k without gathering all logits."""
+        if self.scale <= 0.0 and self.scale != 1.0:
+            raise ValueError(
+                "The local top-k reduction optimization is not supported for "
+                "non-positive logit scaling factors."
+            )
+
+        logits = self._apply_head(lm_head, hidden_states, embedding_bias)
+        shard_indices = lm_head.shard_indices
+
+        if shard_indices.num_org_vocab_padding > 0:
+            logits[
+                ...,
+                shard_indices.num_org_elements : shard_indices.num_org_elements_padded,
+            ] = -float("inf")
+        if shard_indices.num_added_vocab_padding > 0:
+            start = (
+                shard_indices.num_org_elements_padded
+                + shard_indices.num_added_elements
+            )
+            end = (
+                shard_indices.num_org_elements_padded
+                + shard_indices.num_added_elements_padded
+            )
+            logits[..., start:end] = -float("inf")
+
+        values, local_ids = _topk(logits, k)
+        added_start = shard_indices.num_org_elements_padded
+        ids = torch.where(
+            local_ids >= added_start,
+            local_ids - added_start + shard_indices.added_vocab_start_index,
+            local_ids + shard_indices.org_vocab_start_index,
+        ).to(torch.int64)
+
+        if lm_head.tp_size > 1:
+            values = tensor_model_parallel_all_gather(values, dim=-1)
+            ids = tensor_model_parallel_all_gather(ids, dim=-1)
+            values, selected = _topk(values, k)
+            ids = ids.gather(-1, selected)
+
+        values = values.float()
+        if self.scale != 1.0:
+            values = values * self.scale
+        if self.soft_cap is not None:
+            values = torch.tanh(values / self.soft_cap) * self.soft_cap
+        return ids, values
+
