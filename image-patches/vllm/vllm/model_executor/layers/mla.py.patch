+def _current_nvfp4_mla_scale_layout() -> tuple[int, tuple[int, ...]] | None:
+    """Return the cache-layer depth and MLA-bearing layers for the active model.
+
+    GLM-5.2 has MLA on every decoder layer. GLM-5.3 is hybrid: only
+    ``deepseek_sparse_attention`` layers own an MLA KV cache, while its
+    ``linear_attention`` layers must retain identity scale entries. Returning
+    ``None`` preserves validation of legacy artifacts in tooling processes that
+    genuinely have no active vLLM model configuration.
+    """
+    try:
+        vllm_config = get_current_vllm_config()
+    except Exception:
+        return None
+    model_config = getattr(vllm_config, "model_config", None)
+    if model_config is None:
+        return None
+    text_config = getattr(model_config, "hf_text_config", None)
+    if text_config is None:
+        text_config = getattr(model_config, "hf_config", None)
+    if text_config is None:
+        return None
+    num_hidden_layers = getattr(text_config, "num_hidden_layers", None)
+    if type(num_hidden_layers) is not int or num_hidden_layers <= 0:
+        return None
+    num_mtp_layers = getattr(text_config, "num_nextn_predict_layers", 0)
+    if type(num_mtp_layers) is not int or num_mtp_layers < 0:
+        raise ValueError(
+            "active model num_nextn_predict_layers must be a nonnegative integer "
+            "for NVFP4 MLA scale validation"
+        )
+    num_cache_layers = num_hidden_layers + num_mtp_layers
+    layer_types = getattr(text_config, "layer_types", None)
+    if layer_types is None:
+        return num_cache_layers, tuple(range(num_cache_layers))
+    if (
+        not isinstance(layer_types, (list, tuple))
+        or len(layer_types) < num_hidden_layers
+    ):
+        raise ValueError(
+            "active model layer_types must cover every decoder layer for "
+            "NVFP4 MLA scale validation"
+        )
+    backbone_mla_layers = tuple(
+        layer_idx
+        for layer_idx, layer_type in enumerate(layer_types[:num_hidden_layers])
+        if layer_type == "deepseek_sparse_attention"
+    )
+    if not backbone_mla_layers:
+        # Other MLA architectures may expose layer_types using a different
+        # vocabulary. Their established all-layer scale banks remain valid.
+        backbone_mla_layers = tuple(range(num_hidden_layers))
+    # GLM MTP decoder blocks are always constructed as MLA layers after the
+    # target backbone. They own distinct KV records and therefore require
+    # independently calibrated entries in the same absolute-index scale bank.
+    mtp_mla_layers = tuple(range(num_hidden_layers, num_cache_layers))
+    return num_cache_layers, backbone_mla_layers + mtp_mla_layers
+
