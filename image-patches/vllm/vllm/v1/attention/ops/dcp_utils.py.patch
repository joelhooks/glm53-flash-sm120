+    def _direct_combine_with_capacity_fallback(
+        self,
+        partial_output: torch.Tensor,
+        partial_lse: torch.Tensor,
+        *,
+        seq_lens: torch.Tensor,
+        query_start_loc: torch.Tensor,
+        direct_workspace: DirectDCPA2AWorkspace,
+        fallback_combine: DCPCombine,
+        is_lse_base_on_e: bool,
+    ) -> torch.Tensor:
+        """Use the small direct workspace for decode and NCCL for large prefill.
+
+        ``get_dcp_workspace_max_num_tokens`` intentionally sizes direct
+        symmetric memory for decode/spec-decode rows, which is far smaller than
+        ``max_num_batched_tokens``. Sparse MLA also invokes the same combine for
+        chunked prefill. Route those larger, shape-static calls through the
+        ordinary A2A collective instead of overrunning the decode workspace.
+        """
+        if partial_output.shape[0] <= self.max_num_tokens:
+            return direct_workspace.lse_reduce(
+                partial_output,
+                partial_lse,
+                seq_lens=seq_lens,
+                query_start_loc=query_start_loc,
+                is_lse_base_on_e=is_lse_base_on_e,
+            )
+        return fallback_combine(
+            partial_output,
+            partial_lse,
+            seq_lens=seq_lens,
+            query_start_loc=query_start_loc,
         )
 
